{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "teratron/booking",
    "type": "project",
    "description": "International tourism portal-directory for Moldova, Ukraine, and Georgia.",
    "keywords": [
        "tourism",
        "portal",
        "catalog",
        "laravel",
        "filament"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "astrotomic/laravel-translatable": "^11.17.1",
        "filament/filament": "^5.7.6",
        "filament/spatie-laravel-media-library-plugin": "^5.7.6",
        "laravel/framework": "^13.26.1",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "league/flysystem-aws-s3-v3": "^3.35.2",
        "owen-it/laravel-auditing": "^14.0.6",
        "spatie/laravel-medialibrary": "^11.23.5",
        "spatie/laravel-permission": "^8.3.0",
        "spatie/laravel-sitemap": "^8.2.0",
        "staudenmeir/laravel-adjacency-list": "^1.26.1"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5.0",
        "fakerphp/faker": "^1.24.1",
        "icanhazstring/composer-unused": "^0.9.6",
        "larastan/larastan": "^3.10.0",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.4",
        "laravel/pint": "^1.30.5",
        "mockery/mockery": "^1.6.14",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.1.1",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "phpstan/phpstan": "^2.2.8",
        "rector/rector": "^2.6.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "fix": "pint",
        "fix:dirty": "pint --dirty",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": [
            "@php artisan config:clear --ansi",
            "@php -d memory_limit=1G vendor/bin/pest --exclude-group=slow"
        ],
        "test:arch": "@php -d memory_limit=1G vendor/bin/pest --testsuite=Architecture",
        "test:coverage": "@php -d memory_limit=1G vendor/bin/pest --coverage --min=80 --exclude-group=slow",
        "test:slow": "@php -d memory_limit=1G vendor/bin/pest --group=slow",
        "bench": "@php artisan bench:run",
        "unused": "composer-unused",
        "quality": [
            "@lint",
            "@analyse",
            "@test",
            "@test:coverage",
            "composer audit",
            "@unused"
        ],
        "rector:dry": "rector process --dry-run",
        "rector": "rector process",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 1800,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
