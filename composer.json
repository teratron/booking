{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "teratron/booking",
    "type": "project",
    "description": "International tourism portal-directory for Moldova, Ukraine, and Georgia.",
    "keywords": [
        "tourism",
        "portal",
        "catalog",
        "laravel",
        "filament"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.7.6",
        "laravel/framework": "^13.24.0",
        "laravel/tinker": "^3.0.2"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5.0",
        "fakerphp/faker": "^1.24.1",
        "icanhazstring/composer-unused": "^0.9.6",
        "larastan/larastan": "^3.10.0",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.3",
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.0.3",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "phpstan/phpstan": "^2.2.8",
        "rector/rector": "^2.6.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "fix": "pint",
        "fix:dirty": "pint --dirty",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": [
            "@php artisan config:clear --ansi",
            "pest"
        ],
        "test:arch": "pest --testsuite=Architecture",
        "test:coverage": "pest --coverage --min=80",
        "bench": "echo \"No benchmarks defined yet — the harness lands with the schema and seeded volume it measures. Not part of 'composer quality' until it does.\"",
        "unused": "composer-unused",
        "quality": [
            "@lint",
            "@analyse",
            "@test",
            "@test:coverage",
            "@unused",
            "composer audit"
        ],
        "rector:dry": "rector process --dry-run",
        "rector": "rector process",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}