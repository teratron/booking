<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <!-- Its real logic only runs meaningfully against realistic
                 seeded volume — a `slow`-tagged, opt-in concern excluded
                 from the default coverage run for the same reason
                 DemoVolumeSeeder itself is never measured. -->
            <file>app/Console/Commands/RunBenchmarks.php</file>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing" />
        <!-- Fixed regardless of the developer's own .env (Herd's booking.test,
             Docker's localhost:8300, or anything else): PublicHreflangTest
             asserts against this exact absolute host, so leaving it to
             whatever APP_URL a given machine happens to have makes the
             suite pass or fail depending on who's running it. -->
        <env name="APP_URL" value="http://booking.test" />
        <env name="APP_MAINTENANCE_DRIVER" value="file" />
        <env name="BCRYPT_ROUNDS" value="4" />
        <env name="BROADCAST_CONNECTION" value="null" />
        <env name="CACHE_STORE" value="array" />
        <!-- Real PostgreSQL/PostGIS, not SQLite: the schema uses geography
             columns and Postgres-only partial indexes SQLite cannot
             represent. Host, port, and credentials are inherited from the
             application's own environment (docker-compose's DB_HOST=postgres
             override) — only the connection driver and database name change
             for the test run, pointed at a database dedicated to tests. -->
        <env name="DB_CONNECTION" value="pgsql" />
        <env name="DB_DATABASE" value="booking_testing" />
        <env name="DB_URL" value="" />
        <env name="MAIL_MAILER" value="array" />
        <env name="QUEUE_CONNECTION" value="sync" />
        <env name="SESSION_DRIVER" value="array" />
        <env name="PULSE_ENABLED" value="false" />
        <env name="TELESCOPE_ENABLED" value="false" />
        <env name="NIGHTWATCH_ENABLED" value="false" />
    </php>
</phpunit>