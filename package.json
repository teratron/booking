{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.20.0",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "fix": "biome check --write .",
        "lint": "biome check .",
        "analyse": "fallow",
        "analyse:fix": "fallow fix",
        "audit": "fallow audit",
        "audit:ci": "fallow audit --format json",
        "review": "fallow review --brief",
        "quality": "pnpm run lint && pnpm run analyse"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@tailwindcss/vite": "^4.3.3",
        "concurrently": "^10.0.4",
        "fallow": "^3.14.0",
        "laravel-vite-plugin": "^3.1.3",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.1"
    }
}
