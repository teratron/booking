#!/bin/sh
# Versioned pre-commit hook. Installed via `git config core.hooksPath .githooks`
# (see docs/README setup step) so every clone gets the same gate, unlike the
# unversioned .git/hooks/ directory.
#
# No `set -e` here, deliberately: each check below inspects its own exit code
# to print a specific, actionable message before exiting. `set -e` would abort
# on the first non-zero status before that message ever printed.

echo "[Magic Sync] Checking engine integrity..."
node .magic/scripts/executor.js update-engine-meta --check
if [ $? -ne 0 ]; then
  echo "[Magic Sync] Engine drift detected in .magic/."
  echo "[Magic Sync] If this is unintended: restore .magic/ from the magic-spec release archive."
  echo "[Magic Sync] If this is an engine-improvement task: run 'node .magic/scripts/executor.js update-engine-meta' (developer install only)."
  exit 1
fi
echo "[Magic Sync] Engine in sync."

staged_php=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')
staged_js=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.css')

if [ -z "$staged_php" ] && [ -z "$staged_js" ]; then
  echo "[Quality] No staged PHP or JS/CSS files — skipping the formatting gates."
  exit 0
fi

if ! docker compose exec -T app true >/dev/null 2>&1; then
  echo "[Quality] Staged files need the 'app' container to check. Start the stack first: docker compose up -d"
  exit 1
fi

failed=0

if [ -n "$staged_php" ]; then
  echo "[Quality] Checking PHP formatting (pint --test)..."
  if ! docker compose exec -T app vendor/bin/pint --test; then
    echo "[Quality] PHP formatting check failed. Run 'docker compose exec app composer fix' and re-stage."
    failed=1
  fi
fi

if [ -n "$staged_js" ]; then
  echo "[Quality] Checking JS/CSS formatting and lint (biome check)..."
  if ! docker compose exec -T app pnpm run lint; then
    echo "[Quality] JS/CSS check failed. Run 'docker compose exec app pnpm run fix' and re-stage."
    failed=1
  fi
fi

if [ "$failed" -ne 0 ]; then
  exit 1
fi

echo "[Quality] All checks clean. Proceeding to commit..."
exit 0
