APP_NAME="Tourism Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Active interface languages. Launch set is English + Russian; ro/uk/ka are
# activated from the back office after project completion.
APP_SUPPORTED_LOCALES=en,ru

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (PostgreSQL + PostGIS) -----------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=booking
DB_USERNAME=booking
DB_PASSWORD=booking

# --- Cache, session, queue (Redis) -------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- Object storage (S3-compatible: MinIO locally, R2/B2 in production) ------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=booking
AWS_SECRET_ACCESS_KEY=booking-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=booking-media
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Mail (Mailpit locally) ---------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Maps ---------------------------------------------------------------------
# Public OSM tile servers are prohibited for production use by the OSMF tile
# usage policy. Use MapTiler, Stadia, or self-hosted tiles.
MAP_TILE_PROVIDER=maptiler
MAP_TILE_KEY=

# --- Security -----------------------------------------------------------------
# Cloudflare Turnstile or hCaptcha keys for public form protection.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Backups (spatie/laravel-backup) -----------------------------------------
BACKUP_DISK=s3
BACKUP_NOTIFICATION_EMAIL=
