APP_NAME="Tourism Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8300

# The staff panel deliberately does not sit at /admin. Change this per
# deployment; the throttle and the second factor are the real controls, but a
# guessable address invites the traffic they then have to absorb.
ADMIN_PANEL_PATH=portal-admin
CABINET_PANEL_PATH=cabinet
SIGN_IN_MAX_ATTEMPTS=5
SIGN_IN_DECAY_SECONDS=60
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Active interface languages. Launch set is English + Russian; ro/uk/ka are
# activated from the back office after project completion.
APP_SUPPORTED_LOCALES=en,ru

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (PostgreSQL + PostGIS) -----------------------------------------
# DB_PORT is for host-side tooling only (php artisan, IDE database clients) —
# the app/worker/scheduler/pulse containers always reach Postgres over the
# compose network at postgres:5432, regardless of this value. Keep DB_PORT
# equal to whatever DB_HOST_PORT resolves to in docker-compose.yml's postgres
# service (default 5433; override DB_HOST_PORT there if 5433 itself collides
# with something already bound on your machine).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=booking
DB_USERNAME=booking
DB_PASSWORD=booking

# --- Cache, session, queue (Redis) -------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- Object storage (S3-compatible: MinIO locally, R2/B2 in production) ------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=booking
AWS_SECRET_ACCESS_KEY=booking-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=booking-media
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# CDN in front of the media bucket (Cloudflare, in production — see
# docs/production-provisioning.md for the provider switch). Left empty,
# media URLs resolve straight to the bucket's own origin; unrelated to
# BACKUP_DISK/BACKUP_AWS_BUCKET below, which stay a separate destination.
MEDIA_CDN_URL=

# --- Mail (Mailpit locally; a real SMTP relay in production) -----------------
# Mailpit locally — nothing sent leaves the local Docker network. In
# production, point these at the actual relay (Postmark, Amazon SES, Resend,
# or a self-hosted relay) — MAIL_MAILER stays "smtp" for any of them; only
# the host, port, and credentials change. Administrator-editable templates
# live in this project's own notification model, never a provider's own
# templating (see docs/mail-and-error-tracking.md).
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Error tracking (sentry/sentry-laravel) -----------------------------------
# Sentry, or self-hosted GlitchTip as the no-cost alternative — GlitchTip
# speaks the same Sentry ingestion protocol, so only the DSN host changes.
# Empty locally: the SDK stays loaded but sends nothing without a DSN.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"

# --- Queues & observability (Horizon, Pulse) -----------------------------------
# Horizon supervises every declared queue (config/horizon.php) over the same
# Redis connection queues already use (QUEUE_CONNECTION above). Pulse's own
# "redis" ingest keeps every recorded entry off the request/response cycle —
# see config/pulse.php's own docblock for why "storage" (the package's own
# default) is never used here. Both dashboards sit behind the identical
# staff-panel permission every other admin surface uses; there is no
# separate dashboard password to set.
HORIZON_PATH=horizon
PULSE_PATH=pulse
PULSE_INGEST_DRIVER=redis

# --- Maps ---------------------------------------------------------------------
# Public OSM tile servers are prohibited for production use by the OSMF tile
# usage policy. Use MapTiler, Stadia, or self-hosted tiles.
MAP_TILE_PROVIDER="MapTiler"
MAP_TILE_KEY=

# --- Security -----------------------------------------------------------------
# Cloudflare Turnstile or hCaptcha for public form protection — "none"
# leaves CAPTCHA off, matching a fresh clone with no keys configured yet.
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Backups (spatie/laravel-backup) -------------------------------------------
# A dedicated bucket on the same local MinIO instance, never the media
# bucket above — a backup living beside what it protects is not a backup.
# `docker compose up` creates it automatically (see the minio-init service
# in docker-compose.yml); nothing to run by hand.
BACKUP_DISK=backups
BACKUP_AWS_BUCKET=booking-backups
# Unused while config/backup.php's own notification map stays empty (see
# that file) — kept well-formed because Spatie validates it regardless.
BACKUP_NOTIFICATION_EMAIL=ops@example.com
BACKUP_DATABASE_GENERATIONS_TO_KEEP=7
BACKUP_MEDIA_GENERATIONS_TO_KEEP=5
BACKUP_STALENESS_THRESHOLD_HOURS=48
