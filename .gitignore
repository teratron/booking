# Dotenv files (local secrets — never commit)
.env*
!.env.example
!.env.production.example

# IDE
.vscode/
.idea/
*.iml

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
*.log

# Coverage and test reports
# The directory form alone misses the single-file formats PHPUnit and Pest emit
# at the repository root, which is the shape CI coverage uploaders ask for.
coverage/
/coverage.xml
/clover.xml
/junit.xml
/coverage.cobertura.xml

# Temporary folders
# No `cache/` or `*cache/` rule here, deliberately. An unanchored pattern like
# that matches at any depth, which excluded bootstrap/cache/ and
# storage/framework/cache/ outright — and git cannot re-include a file whose
# parent directory is excluded, so the placeholder rules below were dead. With
# core.ignorecase=true it also swallowed any PSR-4 `Cache/` namespace directory
# without a word. Every real cache path is named explicitly instead.
tmp/
temp/
.drafts/*.fig
.references/
.playwright-mcp/

# Editor backup files
*.bak
*.tmp

# --- Secrets: key and certificate material -----------------------------------
# Anywhere in the tree, not only under /storage. TLS material next to the nginx
# config and a deploy key at the repository root are the two that a `git add -A`
# would otherwise sweep up.
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
*.keystore
id_rsa*
id_ed25519*
.htpasswd

# --- PHP / Composer ----------------------------------------------------------
/vendor/
auth.json
# Note: composer.lock IS committed (reproducible installs).

# --- Laravel -----------------------------------------------------------------
/storage/pail
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/public/storage
/public/hot

# Package assets copied into the document root. Regenerated by
# `filament:assets` and `vendor:publish`; a committed copy silently goes stale
# against the installed package version and serves the wrong panel JS.
/public/vendor/
/public/css/filament/
/public/js/filament/
/public/fonts/filament/

# IDE helper stubs — regenerated from vendor/, never committed. A stale
# _ide_helper_models.php makes PHPStan report property errors the code does not
# have.
/_ide_helper.php
/_ide_helper_models.php
/.phpstorm.meta.php

# Backups — spatie/laravel-backup writes here; copies belong off-server per the
# client specification, never in the repository. Note the package produces ZIP
# archives, not bare dumps, so the archive formats matter more than *.sql does.
/storage/app/backups/
/storage/app/private/backups/
/storage/backups/
/backups/

# Pest/PHPUnit's --coverage-html output — a disposable local diagnostic
# artefact regenerated on demand, never the coverage figure itself (that
# comes from `composer test:coverage`'s --min gate in CI).
/storage/coverage-html/
*.sql
*.sql.gz
*.sql.bz2
*.dump
*.dump.gz
# Provisioning SQL and the committed schema dump are source, not backups. These
# negations must stay below the *.sql rule to win.
!/docker/**/*.sql
!/database/schema/*.sql

# --- Frontend build (Vite asset pipeline) ------------------------------------
node_modules/
.pnpm-store/
/public/build/
# Note: package-lock / pnpm-lock IS committed.

# --- Quality tooling caches --------------------------------------------------
.phpunit.result.cache
/.phpunit.cache/
/.pint.cache
/.phpstan.cache/
/phpstan.neon.local
/.rector.cache

# --- Local dev environments --------------------------------------------------
# Compose auto-loads override files; they are per-machine (bind paths, host
# ports, xdebug) and must never be shared.
/docker-compose.override.yml
/docker-compose.override.yaml
/compose.override.yml
/compose.override.yaml
.gemini/
gha-creds-*.json

# Local settings — the personal file only. The shared `settings.json` beside it
# is checked in, like the rest of the agent configuration below.
*/settings.*.local.json
*/settings.local.json

