APP_NAME="Tourism Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://booking.example

# The staff panel deliberately does not sit at /admin. Change this per
# deployment; the throttle and the second factor are the real controls, but a
# guessable address invites the traffic they then have to absorb.
ADMIN_PANEL_PATH=portal-admin
CABINET_PANEL_PATH=cabinet
SIGN_IN_MAX_ATTEMPTS=5
SIGN_IN_DECAY_SECONDS=60
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Active interface languages. Launch set is English + Russian; ro/uk/ka are
# activated from the back office after project completion.
APP_SUPPORTED_LOCALES=en,ru

LOG_CHANNEL=stack
# Debug-level logging in production writes request detail nobody should have
# to sift through and nothing should ever leak. Raise it, never lower it,
# when chasing a specific incident, and drop it back after.
LOG_LEVEL=error

# --- Database (PostgreSQL + PostGIS) -----------------------------------------
# `postgres` is the Docker Compose service name on the production host, not a
# placeholder — the app container reaches it over the compose network, the
# same way it does locally. 5432 is Postgres' own port; the 5433 seen in
# .env.example only exists to avoid colliding with a host-installed Postgres
# when running artisan from outside a container.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=booking
DB_USERNAME=booking_app
DB_PASSWORD=

# --- Cache, session, queue (Redis) -------------------------------------------
# `redis` is likewise the compose service name, not a placeholder.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# --- Object storage (S3-compatible: MinIO locally, R2/B2 in production) ------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# "auto" is Cloudflare R2's own convention; Backblaze B2 wants a real region
# name instead (e.g. us-west-004) — set the one matching the chosen provider.
AWS_DEFAULT_REGION=auto
AWS_BUCKET=booking-media-production
# R2: https://<account-id>.r2.cloudflarestorage.com — B2: the endpoint your
# bucket's region page shows. Path-style addressing is a MinIO-local need,
# not a production one.
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# CDN in front of the media bucket (Cloudflare — see
# docs/production-provisioning.md for the provider switch). Left empty,
# media URLs resolve straight to the bucket's own origin; unrelated to
# BACKUP_DISK/BACKUP_AWS_BUCKET below, which stay a separate destination.
MEDIA_CDN_URL=https://cdn.booking.example

# --- Mail (Mailpit locally; a real SMTP relay in production) -----------------
# Point these at the actual relay (Postmark, Amazon SES, Resend, or a
# self-hosted relay) — MAIL_MAILER stays "smtp" for any of them; only the
# host, port, and credentials change. Administrator-editable templates live
# in this project's own notification model, never a provider's own
# templating (see docs/mail-and-error-tracking.md).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@booking.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Error tracking (sentry/sentry-laravel) -----------------------------------
# Sentry, or self-hosted GlitchTip as the no-cost alternative — GlitchTip
# speaks the same Sentry ingestion protocol, so only the DSN host changes.
# Empty here means the SDK stays loaded but sends nothing without a DSN —
# never leave this empty once the release actually ships.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"

# --- Queues & observability (Horizon, Pulse) -----------------------------------
# Horizon supervises every declared queue (config/horizon.php) over the same
# Redis connection queues already use (QUEUE_CONNECTION above). Pulse's own
# "redis" ingest keeps every recorded entry off the request/response cycle —
# see config/pulse.php's own docblock for why "storage" (the package's own
# default) is never used here. Both dashboards sit behind the identical
# staff-panel permission every other admin surface uses; there is no
# separate dashboard password to set.
HORIZON_PATH=horizon
PULSE_PATH=pulse
PULSE_INGEST_DRIVER=redis

# --- Maps ---------------------------------------------------------------------
# Public OSM tile servers are prohibited for production use by the OSMF tile
# usage policy. Use MapTiler, Stadia, or self-hosted tiles.
MAP_TILE_PROVIDER=maptiler
MAP_TILE_KEY=

# --- Security -----------------------------------------------------------------
# Cloudflare Turnstile or hCaptcha keys for public form protection. Use the
# provider's production keys here, never the always-pass test keys used in
# development.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Backups (spatie/laravel-backup) -------------------------------------------
# A dedicated bucket, on the same or a separate S3-compatible account, never
# the media bucket above — a backup living beside what it protects is not a
# backup. Off-server by construction once this points at R2/B2 rather than a
# local disk.
BACKUP_DISK=backups
BACKUP_AWS_BUCKET=booking-backups-production
BACKUP_NOTIFICATION_EMAIL=ops@booking.example
BACKUP_DATABASE_GENERATIONS_TO_KEEP=7
BACKUP_MEDIA_GENERATIONS_TO_KEEP=5
BACKUP_STALENESS_THRESHOLD_HOURS=48
